# AppzPlay License Gateway - Environment Configuration

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://suscribe.appzplay.online
TRUST_PROXY=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://appzplay_user:appzplay_secure_password_2026@postgres:5432/appzplay_license_db?schema=public

# Security & Sessions
JWT_SECRET=appzplay_super_secret_jwt_key_at_least_32_chars_long_2026!
COOKIE_SECRET=appzplay_cookie_signing_secret_64_characters_long_super_secure_key!
CORS_ORIGIN=https://suscribe.appzplay.online

# Admin Initial Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@appzplay.online
DEFAULT_ADMIN_PASSWORD=AppzPlaySuperAdmin2026!
DEFAULT_ADMIN_NAME=AppzPlay Administrator

# ForwardAuth Tuning
CACHE_TTL_MS=30000
AUDIT_LOG_ENABLED=true
SUSPENDED_REDIRECT_URL=https://suscribe.appzplay.online/suspended
