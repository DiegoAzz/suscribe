{
  "name": "appzplay-license-gateway",
  "version": "1.0.0",
  "description": "Centralized License and Access Control Gateway with Traefik ForwardAuth for Coolify SaaS Applications",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx test/run-tests.ts"
  },
  "keywords": [
    "traefik",
    "forward-auth",
    "license-gateway",
    "coolify",
    "saas",
    "multi-tenant"
  ],
  "author": "AppzPlay",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "lru-cache": "^10.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
